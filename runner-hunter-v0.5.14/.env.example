TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AUTHORIZED_TELEGRAM_USER_ID=

# Supported: mock | cove-paper. Live trading is intentionally unavailable.
BROKER_MODE=mock
# For cove-paper, use credentials associated with the Cove PAPER profile.
COVE_READ_TOKEN=
COVE_WRITE_TOKEN=
COVE_MCP_URL=https://production.cove.trade/api/mcp
# Logs Cove tool schemas and sanitized call arguments; never logs Bearer tokens.
COVE_MCP_DEBUG=false

# GoPlus security deep dive. Leave blank if your access level does not require a bearer token.
# Never paste this credential into Telegram or chat.
GOPLUS_ACCESS_TOKEN=

# Blockscout PRO API key for Robinhood Chain contract verification.
# Create locally at dev.blockscout.com; never paste it into Telegram or chat.
BLOCKSCOUT_API_KEY=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
SECURITY_DEEP_DIVE_ENABLED=true
# Optional: save raw GoPlus + RH Blockscout responses to ./security-debug for troubleshooting.
SECURITY_DEBUG_LOG=false
SECURITY_MAX_BUY_TAX_PERCENT=15
SECURITY_MAX_SELL_TAX_PERCENT=15
SECURITY_MAX_TOP10_PERCENT=60

STARTING_PAPER_CASH_USD=1000
MAX_TRADE_USD=25
MAX_OPEN_POSITIONS=5
MIN_LIQUIDITY_USD=50000
MIN_24H_VOLUME_USD=25000
MAX_MARKET_CAP_USD=25000000

RUNNER_CANDIDATE_FETCH_LIMIT=36
RUNNER_AI_FINALISTS=5
RUNNER_MAX_AGE_HOURS=72
RUNNER_MIN_LIQUIDITY_USD=10000
RUNNER_MIN_VOLUME_1H_USD=5000
